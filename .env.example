PORT=3000

# saas   = many companies, picked per request by the x-tenant header; managed under /admin.
# onprem = one company on the customer's server; no x-tenant header, no /admin routes.
DEPLOYMENT_MODE=saas

# Central (platform) database: tenant registry + super admins.
CENTRAL_DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_central?schema=public

# Template for tenant connections. The app swaps the path (/postgres) for /tenant_<slug>.
TENANT_DB_BASE_URL=postgresql://erp:erp@localhost:5432/postgres?schema=public&connection_limit=5

# Dev only: scratch tenant database used by `npm run migrate:tenant:dev` to author new tenant migrations.
TENANT_DATABASE_URL=postgresql://erp:erp@localhost:5432/tenant_dev?schema=public

# Use long random strings, and different values for the two secrets.
JWT_SECRET=change-me-tenant-jwt-secret
JWT_EXPIRES_IN=1d
# SaaS only.
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN=1h

# --- on-prem only (ignored when DEPLOYMENT_MODE=saas) ---
# The single company is created on first boot from these values.
ONPREM_TENANT_SLUG=main
ONPREM_COMPANY_NAME=My Company
# Only needed on first boot, to create the first admin user.
ONPREM_ADMIN_EMAIL=admin@mycompany.local
ONPREM_ADMIN_PASSWORD=change-me-please
# Comma-separated modules this customer has bought (sales, inventory, purchasing, accounting).
ONPREM_MODULES=sales,inventory

# --- SaaS only ---
# First super admin, created by `npm run seed:admin`.
SUPER_ADMIN_EMAIL=owner@erp.local
SUPER_ADMIN_PASSWORD=change-me-please

PGADMIN_DEFAULT_EMAIL=admin@erp.com
PGADMIN_DEFAULT_PASSWORD=change-me
